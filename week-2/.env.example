# Environment variables for the Docker Compose application stack
# Copy this file to .env and customize the values
# IMPORTANT: Never commit .env to version control. Only .env.example should be in the repo.

# Database configuration
POSTGRES_DB=statustracker
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

# Port mapping for Nginx
# The container listens on port 80; this maps to a port on the host machine
HOST_PORT=8080
